diff --git a/internal/fsclient/cache.go b/internal/fsclient/cache.go
index 5579b22..3bdb5e9 100644
--- a/internal/fsclient/cache.go
+++ b/internal/fsclient/cache.go
@@ -635,7 +635,15 @@ func (c *Cache) Stage(path, hash string, expectedBytes int64) (*StagedRefresh, e
 		c.stats.StagedNoRoomTotal++
 		return nil, err
 	}
