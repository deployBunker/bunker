# Built binaries (root only)
/bunkerd
/bunker

# Secrets
*.token
*.pem
*.key
!id_ed25519_bunker.pub

# IDE
.idea/
.vscode/
*.swp

# Build
/tmp/
/dist/

# Coding Hermes prompts
.coding-hermes/prompt-*.txt
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet

# Hilo graph data
.vfs/
.gitreins/history/
# The guard's own run logs (DF-018). The MAIN checkout hides them through
# .git/info/exclude, which is local and untracked — so a fresh clone, a worktree
# or a CI checkout shows the guard's own artifact as an untracked file the
# moment a commit runs, and the next `git add -A` sweeps it in.
.gitreins/logs/
bin/

# Environment files (secrets)
.env
.env.*
!.env.example

# Python artifacts (cross-repo contamination guard)
*.py
*.pyc
__pycache__/
test-config.yaml

# ...but the repo's own tooling is Python and IS source: re-include tools/.
# Without this the shim + verb regression suite are silently untracked, so a
# "code half landed" commit ships an empty claim (proven 2026-09-20: commit
# 70a94c8 said GAP-097 landed and carried only .gitreins/tasks.yaml).
!tools/*.py
tools/__pycache__/

# ...and so is the upstream sshfs tree (MOUNT-015): its test suite is the
# regression gate for the readdirplus patch, and the patch's probe harness is Python.
# Without these carve-outs `git add third_party/ probes/` silently ships a partial tree
# (the same failure mode as the tools/ one above).
#
# NOTE: this tree lives in third_party/, NOT vendor/: a top-level vendor/ directory
# makes the Go toolchain switch to -mod=vendor and demand vendor/modules.txt, so
# `go build ./...` fails with "inconsistent vendoring" on every host and in CI
# (measured 2026-10-23, CI red from f3d55824 through f04d8a12).
!third_party/sshfs/test/*.py
!probes/sshfs-readdirplus/*.py

# Bunker E2E battery output (regenerated on each run)
e2e-output/

# DAGger MCP runtime state (per-session run/checkpoint DB; CLN-1: an add-sweep
# once committed a live dagger.db into a docs commit — never ship these)
/dagger.db
/dagger.db-shm
/dagger.db-wal
