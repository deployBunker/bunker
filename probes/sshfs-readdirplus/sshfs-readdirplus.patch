+/*
+ * Is a write() possibly still pending on this directory entry?
+ *
+ * readdirplus (FUSE_FILL_DIR_PLUS) hands attributes to the kernel, so they must not be
+ * stale. A pending write() can change a file's length after the directory listing was
+ * fetched from the server. sshfs.conntab contains exactly the paths that are open with a
+ * possible in-flight write(), and sshfs_getattr() routes those paths to the connection
+ * that owns the write. So the paths found here are the ones whose readdir() attributes
+ * cannot be trusted.
+ *
+ * Conntab only exists when max_conns > 1 (see the comment block at the top of this
+ * file). With a single connection every request goes over the same SFTP channel in
+ * order, so a readdir() issued after a write() sees the written length - nothing to do.
+ */
+static int dir_entry_may_have_pending_write(const char *dirpath,
+					    const char *name)
+{
+	struct conntab_entry *ce;
+	char *entry_path;
+	int pending;
+
+	if (sshfs.conntab == NULL)
+		return 0;
+
+	/* Never suppress attributes for . and .. (kernel fills those itself) */
+	if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
+		return 0;
+
+	/* Behaves as if the entry has a pending write (conservative) */
+	if (dirpath == NULL)
+		return 1;
+
+	if (strcmp(dirpath, "/") == 0)
+		entry_path = g_strdup_printf("/%s", name);
+	else
+		entry_path = g_strdup_printf("%s/%s", dirpath, name);
+	if (entry_path == NULL)
+		return 1;
+
+	pthread_mutex_lock(&sshfs.lock);
+	ce = g_hash_table_lookup(sshfs.conntab, entry_path);
+	pthread_mutex_unlock(&sshfs.lock);
+	pending = (ce != NULL);
+
+	g_free(entry_path);
+	return pending;
+}
